# ─── Base de données (Neon, région Francfort recommandée) ───────────────────────
# URL mutualisée (pooler) utilisée par l'application
DATABASE_URL="postgresql://utilisateur:motdepasse@ep-xxxx-pooler.eu-central-1.aws.neon.tech/diwaa?sslmode=require"
# URL directe (sans pooler) utilisée par les migrations Prisma
DIRECT_URL="postgresql://utilisateur:motdepasse@ep-xxxx.eu-central-1.aws.neon.tech/diwaa?sslmode=require"
# Taille du pool de connexions par instance
DB_POOL_MAX=5

# ─── Authentification (Auth.js) ────────────────────────────────────────────────
# Générer avec : npx auth secret   (ou : openssl rand -base64 32)
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# ─── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://diwaamagazine.com"

# ─── Compte super-administrateur créé par le seed (npm run db:seed) ─────────────
SEED_ADMIN_NOM="Super Administrateur"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# ─── Médias (Cloudinary) ───────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="diwaa-magazine"

# ─── E-mails et newsletter (Resend) ────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="DIWA MAG <redaction@diwaamagazine.com>"
# Destinataire des alertes de modération et du formulaire de contact
ADMIN_NOTIFICATION_EMAIL=""
CONTACT_EMAIL=""

# ─── Traduction automatique FR → EN (DeepL) — facultatif ─────────────────────
# Clé gratuite (se termine par :fx) ou payante. Sans clé, la version anglaise se saisit dans le back-office.
DEEPL_API_KEY=""

# ─── Importation d'articles depuis un PDF (back-office › Import PDF) ───────────
# Clé de l'API Anthropic (console.anthropic.com) pour l'analyse par IA. Sans clé, une analyse
# automatique simplifiée est utilisée et les PDF scannés ne peuvent pas être lus.
ANTHROPIC_API_KEY=""
# Modèle utilisé (par défaut claude-opus-5-5 ; claude-sonnet-5-5 coûte environ deux fois moins cher).
ANTHROPIC_MODEL=""
# Limites (valeurs par défaut) : taille en Mo (22 au maximum), pages par PDF, jours de conservation du PDF source.
IMPORT_PDF_TAILLE_MAX_MO="20"
IMPORT_PDF_PAGES_MAX="16"
IMPORT_PDF_CONSERVATION_JOURS="7"

# ─── Anti-spam (Cloudflare Turnstile) — facultatif ─────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ─── Notifications push (VAPID) — générer avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:redaction@diwaamagazine.com"

# ─── Publication programmée (Vercel Cron) ──────────────────────────────────────
CRON_SECRET=""

# ─── Play Store (Trusted Web Activity) ─────────────────────────────────────────
ANDROID_PACKAGE_NAME="com.diwaamagazine.app"
ANDROID_SHA256_FINGERPRINTS=""

# ─── Réseaux sociaux (liens du site) ───────────────────────────────────────────
NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/femmedigitaleafrique"
NEXT_PUBLIC_LINKEDIN_URL="https://www.linkedin.com/showcase/digiewomen-awards-africa/"
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/digiewomen_awardsafrica"
NEXT_PUBLIC_YOUTUBE_URL="https://www.youtube.com/@digiewomenawards"
