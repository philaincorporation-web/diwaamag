// Schéma de données du Magazine DIWAA — conforme à la section 8.1 du document d'architecture.
//
// Écarts justifiés (Prisma 7) :
//  - generator "prisma-client" (le générateur "prisma-client-js" est déprécié en v7) avec une sortie dans lib/generated ;
//  - les URL de connexion (DATABASE_URL / DIRECT_URL) ne sont plus déclarées ici mais dans prisma.config.ts
//    (migrations) et lib/db.ts (adaptateur PostgreSQL à l'exécution).
// Ajouts justifiés :
//  - Article.videoUrl : URL de la vidéo principale des contenus de type VIDEO (dont l'avatar IA AFDY) ;
//  - Article.dateMiseAJour : date de dernière mise à jour éditoriale affichée au public (exigée en 4.4),
//    distincte de modifieLe qui change à chaque écriture technique (compteur de vues, statut…) ;
//  - ArticleTraduction, Rubrique.nomEn/descriptionEn, Numero.titreEn/editoEn : version anglaise du magazine
//    (lecteurs des zones anglophones), saisie ou relue dans le back-office.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum StatutArticle {
  BROUILLON
  PROGRAMME
  PUBLIE
  ARCHIVE
  CORBEILLE
}

enum TypeContenu {
  ACTUALITE
  INTERVIEW
  DOSSIER
  VIDEO
}

enum FamilleRubrique {
  GEOGRAPHIQUE
  THEMATIQUE
}

enum TypeMedia {
  IMAGE
  VIDEO
  PDF
}

enum StatutCommentaire {
  EN_ATTENTE
  APPROUVE
  REJETE
  SIGNALE
}

model Admin {
  id                String            @id @default(cuid())
  nom               String
  email             String            @unique
  motDePasse        String
  role              Role              @default(ADMIN)
  actif             Boolean           @default(true)
  avatarUrl         String?
  bio               String?
  derniereConnexion DateTime?
  articles          Article[]         @relation("AuteurArticles")
  versions          ArticleVersion[]
  medias            Media[]
  journal           JournalActivite[]
  importsPdf        ImportPdf[]
  creeLe            DateTime          @default(now())
  modifieLe         DateTime          @updatedAt
}

model Article {
  id              String              @id @default(cuid())
  titre           String
  slug            String              @unique
  chapeau         String
  contenu         Json
  imageUneUrl     String?
  imageUneAlt     String?
  videoUrl        String?
  type            TypeContenu         @default(ACTUALITE)
  statut          StatutArticle       @default(BROUILLON)
  aLaUne          Boolean             @default(false)
  ordreUne        Int?
  tempsLecture    Int?
  vues            Int                 @default(0)
  metaTitre       String?
  metaDescription String?
  /// Contenu partenaire (sponsorisé) : nom du partenaire, affiché « Contenu partenaire ». Vide = article éditorial.
  partenaire      String?
  datePublication DateTime?
  dateProgrammee  DateTime?
  dateMiseAJour   DateTime?
  auteurId        String
  auteur          Admin               @relation("AuteurArticles", fields: [auteurId], references: [id])
  rubriqueId      String
  rubrique        Rubrique            @relation(fields: [rubriqueId], references: [id])
  motsCles        ArticleMotCle[]
  versions        ArticleVersion[]
  traductions     ArticleTraduction[]
  commentaires    Commentaire[]
  numeros         NumeroArticle[]
  importPdf       ImportPdf?
  creeLe          DateTime            @default(now())
  modifieLe       DateTime            @updatedAt

  @@index([statut, datePublication])
  @@index([rubriqueId])
}

model ArticleTraduction {
  id          String   @id @default(cuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  langue      String
  titre       String
  chapeau     String
  contenu     Json
  // true : traduction automatique non relue ; false : relue par la rédaction
  automatique Boolean  @default(false)
  creeLe      DateTime @default(now())
  modifieLe   DateTime @updatedAt

  @@unique([articleId, langue])
}

model ArticleVersion {
  id           String   @id @default(cuid())
  articleId    String
  article      Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  titre        String
  contenu      Json
  modifieParId String
  modifiePar   Admin    @relation(fields: [modifieParId], references: [id])
  creeLe       DateTime @default(now())

  @@index([articleId])
}

model Rubrique {
  id            String          @id @default(cuid())
  nom           String          @unique
  nomEn         String?
  slug          String          @unique
  description   String?
  descriptionEn String?
  famille       FamilleRubrique
  /// Rubrique sponsorisée : « présentée par … »
  sponsorNom     String?
  sponsorLien    String?
  sponsorLogoUrl String?
  ordre         Int             @default(0)
  couleur       String?
  articles      Article[]
}

model MotCle {
  id       String          @id @default(cuid())
  nom      String          @unique
  slug     String          @unique
  articles ArticleMotCle[]
}

model ArticleMotCle {
  articleId String
  motCleId  String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  motCle    MotCle  @relation(fields: [motCleId], references: [id], onDelete: Cascade)

  @@id([articleId, motCleId])
}

model Media {
  id              String    @id @default(cuid())
  url             String
  publicId        String
  type            TypeMedia
  legende         String?
  texteAlternatif String
  largeur         Int?
  hauteur         Int?
  ajouteParId     String
  ajoutePar       Admin     @relation(fields: [ajouteParId], references: [id])
  creeLe          DateTime  @default(now())
}

model Commentaire {
  id           String            @id @default(cuid())
  articleId    String
  article      Article           @relation(fields: [articleId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       Commentaire?      @relation("Reponses", fields: [parentId], references: [id])
  reponses     Commentaire[]     @relation("Reponses")
  nom          String
  email        String
  message      String
  lien         String?
  statut       StatutCommentaire @default(EN_ATTENTE)
  signalements Int               @default(0)
  adresseIp    String?
  creeLe       DateTime          @default(now())

  @@index([articleId, statut])
  @@index([email])
}

model Numero {
  id            String          @id @default(cuid())
  titre         String
  titreEn       String?
  slug          String          @unique
  mois          DateTime
  couvertureUrl String
  pdfUrl        String?
  edito         String?
  editoEn       String?
  publie        Boolean         @default(false)
  articles      NumeroArticle[]
  creeLe        DateTime        @default(now())
}

model NumeroArticle {
  numeroId  String
  articleId String
  ordre     Int     @default(0)
  numero    Numero  @relation(fields: [numeroId], references: [id], onDelete: Cascade)
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([numeroId, articleId])
}

model AbonneNewsletter {
  id                String    @id @default(cuid())
  email             String    @unique
  confirme          Boolean   @default(false)
  jetonConfirmation String?   @unique
  desinscritLe      DateTime?
  creeLe            DateTime  @default(now())
}

model AbonnementPush {
  id               String               @id @default(cuid())
  endpoint         String               @unique
  p256dh           String
  auth             String
  /// Préférences du lecteur (le site n'a pas de comptes lecteurs : elles suivent l'abonnement de l'appareil).
  langue           String               @default("fr")
  articles         Boolean              @default(true)  // nouveaux articles du magazine
  veille           Boolean              @default(false) // actualités de la Veille Média
  categoriesVeille String[]             @default([])    // slugs suivis ; vide = toutes
  zonesVeille      ZoneVeille[]         @default([])    // vide = toutes
  creeLe           DateTime             @default(now())
  modifieLe        DateTime             @default(now()) @updatedAt
  notifications    NotificationVeille[]
}

model JournalActivite {
  id      String   @id @default(cuid())
  adminId String
  admin   Admin    @relation(fields: [adminId], references: [id])
  action  String
  cible   String
  cibleId String?
  details Json?
  creeLe  DateTime @default(now())

  @@index([adminId, creeLe])
}

model Parametre {
  cle    String @id
  valeur Json
}

// ─── Importation intelligente de PDF ─────────────────────────────────────────
// Suivi d'un import : fichier source (stocké 7 jours), état du traitement,
// résultat de l'analyse à faire valider, et article brouillon créé à la fin.
enum StatutImport {
  TELEVERSE   // fichier en cours d'envoi / reçu
  EN_ATTENTE  // traitement demandé
  EN_COURS    // extraction et analyse en cours
  A_VERIFIER  // résultat prêt, validation humaine requise
  TERMINE     // brouillon créé
  ECHEC
  ANNULE
}

model ImportPdf {
  id               String       @id @default(cuid())
  statut           StatutImport @default(TELEVERSE)
  nomFichier       String
  taille           Int
  empreinte        String       // SHA-256 du fichier : évite les imports en double
  pages            Int?
  stockage         String       // "cloudinary" ou "local" (développement)
  sourceId         String       // public_id Cloudinary (privé) ou nom du fichier local
  sourceSupprimee  Boolean      @default(false)
  etape            String?      // libellé de l'étape en cours, affiché au rédacteur
  progression      Int          @default(0)
  resultat         Json?        // analyse validée (schéma strict) + images extraites
  erreur           String?
  tentatives       Int          @default(0)
  modele           String?      // modèle d'IA utilisé, ou "heuristique"
  tokensEntree     Int?
  tokensSortie     Int?
  debutTraitement  DateTime?
  expireLe         DateTime     // date de suppression du PDF source
  adminId          String
  admin            Admin        @relation(fields: [adminId], references: [id])
  articleId        String?      @unique
  article          Article?     @relation(fields: [articleId], references: [id], onDelete: SetNull)
  creeLe           DateTime     @default(now())
  modifieLe        DateTime     @updatedAt

  @@index([empreinte])
  @@index([statut])
}

// ─── Publicité ───────────────────────────────────────────────────────────────
enum EmplacementPub {
  HAUT_PAGE       // bannière sous la navigation, toutes les pages
  ACCUEIL         // bannières entre les sections de l'accueil
  ARTICLE_HAUT    // dans l'article, après le partage (avant le texte)
  ARTICLE_BAS     // dans l'article, après le texte
  BARRE_LATERALE  // pavé dans la barre latérale
  SPONSORS        // mur de logos des partenaires, au-dessus du pied de page
  NEWSLETTER      // bannière en tête des lettres d'information
}

model Publicite {
  id          String         @id @default(cuid())
  nom         String         // nom de la campagne (interne)
  annonceur   String
  emplacement EmplacementPub
  imageUrl    String
  imageAlt    String
  lien        String
  debut       DateTime?
  fin         DateTime?
  actif       Boolean        @default(true)
  /// Poids de rotation : une campagne de poids 2 s'affiche deux fois plus souvent.
  poids       Int            @default(1)
  affichages  Int            @default(0)
  clics       Int            @default(0)
  creeLe      DateTime       @default(now())
  modifieLe   DateTime       @updatedAt

  @@index([emplacement, actif])
}

model DemandeAnnonceur {
  id           String   @id @default(cuid())
  nom          String
  organisation String
  email        String
  telephone    String?
  offre        String?
  message      String
  langue       String   @default("fr")
  traitee      Boolean  @default(false)
  creeLe       DateTime @default(now())
}

// ─── Veille Média ────────────────────────────────────────────────────────────
enum ZoneVeille {
  GABON
  AFRIQUE_CENTRALE
  AFRIQUE_OUEST
  AFRIQUE_EST
  AFRIQUE_AUSTRALE
  AFRIQUE_NORD
  INTERNATIONAL
  NON_PRECISE
}

model SourceVeille {
  id                 String            @id @default(cuid())
  nom                String
  url                String            @unique // adresse du flux RSS / Atom (dont Google Alerts)
  siteUrl            String?
  langue             String            @default("fr")
  /// Zone appliquée quand aucun pays n'est reconnu dans l'actualité (ex. média gabonais → Gabon).
  zoneParDefaut      ZoneVeille?
  /// Catégorie appliquée quand aucun mot-clé n'est reconnu (ex. média tech → innovation).
  categorieParDefaut String?
  /// Média généraliste : ne garder que les actualités reconnues dans une catégorie technologique.
  filtrerTech        Boolean           @default(false)
  actif              Boolean           @default(true)
  dernierReleve      DateTime?
  dernierStatut      String?           // "ok" ou "erreur"
  derniereErreur     String?
  derniersAjouts     Int?
  echecsConsecutifs  Int               @default(0)
  creeLe             DateTime          @default(now())
  modifieLe          DateTime          @updatedAt
  actualites         ActualiteVeille[]
}

model CategorieVeille {
  id       String   @id @default(cuid())
  slug     String   @unique
  nom      String
  nomEn    String
  /// Mots-clés (FR et EN) utilisés pour le classement automatique.
  motsCles String[] @default([])
  ordre    Int      @default(0)
  actif    Boolean  @default(true)
}

model ActualiteVeille {
  id              String               @id @default(cuid())
  sourceId        String
  source          SourceVeille         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  titre           String
  extrait         String               // extrait court (jamais l'article complet)
  url             String
  urlCanonique    String               @unique
  empreinte       String               // titre normalisé : doublons entre sources
  imageUrl        String?
  langue          String               @default("fr")
  datePublication DateTime
  categories      String[]             @default([])
  zone            ZoneVeille           @default(NON_PRECISE)
  masquee         Boolean              @default(false)
  /// Traitement des notifications effectué (envoyées ou volontairement ignorées).
  notifiee        Boolean              @default(false)
  creeLe          DateTime             @default(now())
  notifications   NotificationVeille[]

  @@index([datePublication])
  @@index([empreinte])
  @@index([masquee, datePublication])
}

/// Historique des notifications : une seule par actualité et par abonnement (clé unique).
model NotificationVeille {
  id           String          @id @default(cuid())
  abonnementId String
  abonnement   AbonnementPush  @relation(fields: [abonnementId], references: [id], onDelete: Cascade)
  actualiteId  String
  actualite    ActualiteVeille @relation(fields: [actualiteId], references: [id], onDelete: Cascade)
  envoyee      Boolean         @default(true)
  creeLe       DateTime        @default(now())

  @@unique([abonnementId, actualiteId])
}
